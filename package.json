{
  "name": "tokopt-vscode",
  "displayName": "tokopt — Token Optimization for Copilot",
  "description": "Token-cost CodeLens + anti-pattern Diagnostics + Quick Fix for Copilot customization files (instructions, agents, skills).",
  "version": "0.4.0",
  "publisher": "shinyay",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shinyay/tokopt-vscode.git"
  },
  "homepage": "https://github.com/shinyay/tokopt-vscode#readme",
  "bugs": {
    "url": "https://github.com/shinyay/tokopt-vscode/issues"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "copilot",
    "token",
    "optimization",
    "codelens",
    "diagnostics",
    "code-actions",
    "quick-fix",
    "tokopt"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:markdown",
    "workspaceContains:**/.github/copilot-instructions.md",
    "workspaceContains:**/copilot-instructions.md",
    "workspaceContains:**/instructions.md",
    "workspaceContains:**/*.agent.md",
    "workspaceContains:**/*.chatmode.md",
    "workspaceContains:**/*.prompt.md",
    "workspaceContains:**/SKILL.md",
    "workspaceContains:**/.vscode/mcp.json",
    "workspaceContains:**/.cursor/mcp.json",
    "workspaceContains:**/.copilot/mcp-config.json"
  ],
  "contributes": {
    "configuration": {
      "title": "tokopt",
      "properties": {
        "tokopt.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show inline token-cost CodeLens on Copilot customization files."
        },
        "tokopt.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Surface tokopt detect anti-pattern findings in the Problems panel. Refreshes on save of any customization file."
        },
        "tokopt.binaryPath": {
          "type": "string",
          "default": "tokopt",
          "description": "Path to the tokopt binary. Use 'tokopt' to resolve from PATH, or an absolute path."
        }
      }
    },
    "commands": [
      {
        "command": "tokopt.refreshDiagnostics",
        "title": "tokopt: Refresh Diagnostics"
      },
      {
        "command": "tokopt.clearDiagnostics",
        "title": "tokopt: Clear Diagnostics"
      },
      {
        "command": "tokopt.applySlim",
        "title": "tokopt: Apply slim suggestion to current file"
      },
      {
        "command": "tokopt.previewSlim",
        "title": "tokopt: Preview slim diff for current file"
      },
      {
        "command": "tokopt.suppressFinding",
        "title": "tokopt: Suppress finding (Quick Fix only)"
      },
      {
        "command": "tokopt.learnMore",
        "title": "tokopt: Open anti-patterns chapter"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "tokopt.applySlim",
          "when": "false"
        },
        {
          "command": "tokopt.previewSlim",
          "when": "false"
        },
        {
          "command": "tokopt.suppressFinding",
          "when": "false"
        },
        {
          "command": "tokopt.learnMore",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.4.0"
  }
}
